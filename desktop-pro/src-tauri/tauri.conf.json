{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hanna & Ada Diagnostics PRO",
  "version": "0.2.0",
  "identifier": "app.hannaada.diagnostics.pro",
  "build": {
    "frontendDist": "../../public"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Hanna & Ada Diagnostics PRO",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "shortDescription": "Offline-first BMW diagnostic workstation",
    "longDescription": "Hanna & Ada Diagnostics PRO desktop host. Read-only-first architecture with explicit transport and ECU evidence gates."
  }
}

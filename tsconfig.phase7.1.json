{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "useUnknownInCatchVariables": true,
    "noEmit": true
  },
  "include": [
    "src/telemetry/**/*.ts",
    "src/inference/**/*.ts",
    "src/storage/**/*.ts",
    "src/api/**/*.ts",
    "test/phase7.2-vectors.ts"
  ]
}
